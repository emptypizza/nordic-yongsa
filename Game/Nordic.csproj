<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <!-- net10.0 is the project default (see .claude/rules/godot.md): avoids the
         Directory.Build.props net8.0 auto-insert bug (godot#103545) and runs
         natively on this machine's .NET 10 SDK. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Godot 4.6.3 Android export templates only bundle the net9.0 .NET runtime,
         so build Android export only against net9.0. Desktop/editor stays net10.0. -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
</Project>
